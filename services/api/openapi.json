    "/instruments/{symbol}/bars": {
      "get": {
        "tags": [
          "instruments"
        ],
        "summary": "Bars",
        "operationId": "bars_instruments__symbol__bars_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(1m|3m|1y|2y|5y)$",
              "default": "1y",
              "title": "Range"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Refresh"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BarsOut"
