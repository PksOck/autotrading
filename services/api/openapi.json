{
  "openapi": "3.1.0",
  "info": {
    "title": "Preža API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Liveness only: the process is up. Dependencies are in /system/status.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/system/status": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "System Status",
        "operationId": "system_status_system_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "ServiceId": {
        "type": "string",
        "enum": [
          "postgres",
          "redis",
          "litellm",
          "ollama",
          "ib_gateway",
          "ibkr_flex",
          "telegram"
        ],
        "title": "ServiceId"
      },
      "ServiceState": {
        "type": "string",
        "enum": [
          "up",
          "degraded",
          "down",
          "unconfigured"
        ],
        "title": "ServiceState"
      },
      "ServiceStatus": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ServiceId"
          },
          "state": {
            "$ref": "#/components/schemas/ServiceState"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "title": "ServiceStatus"
      },
      "SystemStatus": {
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceStatus"
            },
            "type": "array",
            "title": "Services"
          }
        },
        "type": "object",
        "required": [
          "as_of",
          "services"
        ],
        "title": "SystemStatus"
      }
    }
  }
}
