# Kopiraj v .env (ni v repoju). Ref: infra/README.md

# --- jedro ---
APP_ENV=production
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-preza-
WEB_BIND=127.0.0.1
APP_BASE_URL=https://preza.<tailnet>.ts.net
DEFAULT_LOCALE=sl

# --- LLM (ADR-0004) ---
OLLAMA_BASE_URL=http://<gpu-naprava>:11434
LOCAL_MODEL=ollama_chat/qwen3.8:27b
EMBED_MODEL=ollama/bge-m3
OPENCODE_API_KEY=
OPENCODE_QUICK_MODEL=openai/glm-5.2
OPENCODE_DEEP_MODEL=openai/kimi-k3
MINIMAX_API_KEY=
MINIMAX_MODEL=openai/MiniMax-M3
# OpenAI: ChatGPT prijava se izvede interaktivno (BL-013), ključ ni potreben

# --- IBKR ---
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IB_GATEWAY_USER=
IB_GATEWAY_PASSWORD=
IB_GATEWAY_TRADING_MODE=live
IB_GATEWAY_PORT=4003
# Read-Only API je v docker-compose.yml vedno vklopljen (ADR-0006)

# --- podatki ---
FINNHUB_API_KEY=
FRED_API_KEY=
SEC_EDGAR_USER_AGENT="Preza research <email>"

# --- obvestila (ADR-0007) ---
TELEGRAM_BOT_TOKEN=
