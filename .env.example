# Canonical public URL of the deployment. Required in production so the
# sitemap and shared links use the real origin instead of localhost.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Milestone 4 — licensed market data provider (server-only, never NEXT_PUBLIC_).
# Composite router: Finnhub (stock prices, 60/min) -> AlphaVantage fallback (25/day)
# FMP fundamentals (quota-tight: 10/day, cached 30d) -> fixture fallback.
# Crypto via CoinGecko demo key (10k/mo, 365d history). Macro via FRED.
# FINNHUB_API_KEY=
# FMP_API_KEY=
# ALPHAVANTAGE_API_KEY=
# COINGECKO_API_KEY=
# FRED_API_KEY=
