# Kopiraj v .env (ni v repoju). Ref: infra/README.md

# --- jedro ---
APP_ENV=production
BASE_CURRENCY=EUR
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-preza-
WEB_BIND=127.0.0.1
APP_BASE_URL=https://preza.<tailnet>.ts.net
DEFAULT_LOCALE=sl

# --- LLM (ADR-0004) ---
OLLAMA_BASE_URL=http://<gpu-naprava>:11434
LOCAL_MODEL=ollama_chat/qwen3.8:27b
EMBED_MODEL=ollama/bge-m3
OPENCODE_API_KEY=
OPENCODE_QUICK_MODEL=openai/glm-5.2
OPENCODE_DEEP_MODEL=openai/kimi-k3
MINIMAX_API_KEY=
MINIMAX_MODEL=openai/MiniMax-M3
# OpenAI: ChatGPT prijava se izvede interaktivno (BL-013), ključ ni potreben

# --- IBKR ---
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IB_GATEWAY_USER=
IB_GATEWAY_PASSWORD=
IB_GATEWAY_TRADING_MODE=live
IB_GATEWAY_PORT=4003
IB_GATEWAY_ENABLED=false   # true, ko zaženeš: docker compose --profile broker up -d
# Read-Only API je v docker-compose.yml vedno vklopljen (ADR-0006)

# --- podatki (rezervni viri za dnevne sveče) ---
YAHOO_ENABLED=true
STOOQ_ENABLED=true
FINNHUB_API_KEY=            # novice (Radar) in vrednotenje (Vstopi, tedensko)
BENCHMARK_SYMBOL=SPY        # primerjava za vzrok padca in alfo signalov
RSS_ENABLED=true
RADAR_SIGNAL_THRESHOLD=0.6
RADAR_NOTIFY_THRESHOLD=0.7
FRED_API_KEY=
SEC_EDGAR_USER_AGENT="Preza research <email>"

# --- obvestila (ADR-0007) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP notification connection; recipients and selected notification kinds are saved in Settings.
# No email is sent until SMTP is configured and email delivery explicitly enabled in Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls     # starttls or tls; encrypted transport is required

# Globoka analiza (M4, services/agents): vloge LiteLLM za hitri in globoki nivo TradingAgents
DEEP_QUICK_ROLE=cloud-quick
DEEP_DEEP_ROLE=cloud-deep
DEEP_DEBATE_ROUNDS=1        # 1 do 3; več krogov je dražje
DEEP_DAILY_LIMIT=6          # globoke analize na dan (UTC); 0 = brez omejitve
